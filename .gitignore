# Rendered output. SVG is a scratch step on the way to a PNG and is never kept.
*.svg

# PNG is generated too, but examples/ is the gallery: those pictures are what a
# reader sees in the README without installing anything, so they are committed
# alongside their source. Everywhere else a PNG is build output.
*.png
!examples/*.png

# Backups written by the installer, if the default location is overridden into
# a checkout. A backup inside a directory that gets copied elsewhere is the
# specific mistake this repository documents.
*.bak
*.bak.*
*.orig
*.rej

# AI assistant artefacts.
CLAUDE.md
AGENTS.md
.claude/
.codex/
.cursor/
.gemini/
.ai-context/
.memsearch/
.opencode/

# Work notes about this repository — kept per checkout, not part of what ships.
kb/

# Per-machine settings read by release.sh — D2_MIRRORS points at a copy of the
# skill that exists on this machine only.
.release.env

# Python bytecode.
__pycache__/
*.pyc

# OS and editor noise.
.DS_Store
Thumbs.db
*.swp
*~

# >>> ai-gitignore managed block (edit via ai-gitignore skill, not here) >>>
# Claude Code
CLAUDE.local.md

# Codex / Cursor / Aider (generic AI agent files)
.cursorrules
.aider*

# Gemini CLI
GEMINI.md

# Continue.dev / Codeium / Windsurf / Copilot
.continue/
.codeium
.windsurf/
.windsurfrules
.github/copilot-instructions.md
COPILOT.md

# Other AI agents / assistants
.antigravity/
.kilocode/
.cline/
.roo/
.serena/
.qodo/
.tabnine/

# Common AI session artifacts (generated by tools, not infrastructure).
# Root-only: the same names are ordinary docs below the root (docs/CHANGE.md).
/PREREQUISITES.md
/CHANGE.md
*.original.md

# AI skill packages (Claude/Cursor skill format). The directories are root-only:
# an unanchored *-skill/ also hides skills/<name>-skill/ in a skills repo.
*.skill
/*-skill/
/*-skill-unpacked/

# Repo preflight / context artifacts (repomix, aider map, llm prompts)
.repomix/
repomix-output.*
aider.repo-map.txt
llm-prompt.md

# kb work notes (the kb skill), local to this machine. Root-only: skills/kb/ in
# the kb repo is source, and apply.py leaves these out where kb/ is committed.
/kb/
/.kb/

# Timestamped pre-edit backups (incl. ai-gitignore skill's own .gitignore backups)
*._MOD_backup.*

# Terraform / OpenTofu local state, plans and overrides
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# IDE / editor
.idea/
.vscode/
*.swo

# Logs
*.log

# Temp / scratch / local backups. tmp/ is root-only: tests/fixtures/tmp/ is source.
/tmp/
*.tmp

# Python tool caches
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/
# <<< ai-gitignore managed block <<<
